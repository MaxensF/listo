<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">

    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Android 13+ runtime permission for the "shopping done" alert. -->
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
    <!-- Needed by JobScheduler's setPersisted so the done-check survives
         reboots. -->
    <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />

    <!-- Android 11+ package visibility: without this, resolveActivity
         for IMAGE_CAPTURE returns null and the camera option silently
         disappears from the loyalty-card file chooser. -->
    <queries>
        <intent>
            <action android:name="android.media.action.IMAGE_CAPTURE" />
        </intent>
    </queries>

    <!--
      usesCleartextTraffic: required because Home Assistant is served over
      plain HTTP on the Tailscale/LAN IP (100.x / 192.168.x).
      Safe here: traffic never leaves the private tailnet.
    -->
    <application
        android:label="@string/app_name"
        android:icon="@drawable/listo_icon"
        android:usesCleartextTraffic="true"
        android:theme="@android:style/Theme.Material.NoActionBar">

        <!-- configChanges: rotation must NOT recreate the WebView, so the
             checklist survives a phone flip mid-store. -->
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:configChanges="orientation|screenSize|keyboardHidden|smallestScreenSize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Periodic background check: notifies when another device
             cleared the shopping list. -->
        <service
            android:name=".ListoJobService"
            android:permission="android.permission.BIND_JOB_SERVICE"
            android:exported="false" />

        <!-- Loyalty-card scan: the <input type=file> flow hands the
             camera app a content:// URI it can write the photo into.
             Private provider + per-URI grant, so no camera or storage
             permission is needed at all. -->
        <provider
            android:name=".PhotoProvider"
            android:authorities="com.listo.app.photo"
            android:exported="false"
            android:grantUriPermissions="true" />
    </application>
</manifest>
